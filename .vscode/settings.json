{
    // --- Enable new C# Dev Kit language server ---
    "dotnet.server.useOmnisharp": false,
    "dotnet.server.useRoslyn": true,

    // --- IntelliSense behavior ---
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.parameterHints.enabled": true,
    "editor.suggest.showWords": true,

    // --- General editing improvements ---
    "editor.acceptSuggestionOnEnter": "on",
    "editor.inlineSuggest.enabled": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,

    // --- File associations ---
    "files.associations": {
        "*.cs": "csharp",
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml"
    },

    // --- Optional performance tweak ---
    "dotnet.server.logging.level": "information",

    // --- (Optional) If you had OmniSharp logs or errors lingering ---
    "omnisharp.enable": false,

    // --- File explorer organization ---
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj"
    },

    // --- Unity project exclusion ---
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "Library/": true,
        "Temp/": true,
        "Obj/": true,
        "Build/": true,
        "Logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true
    },

    "dotnet.defaultSolution": "feed-the-animals-thedisage.sln"
}

